# systemd unit for running the sidecar without Docker, behind a reverse
# proxy (Caddy or nginx) on the same machine that terminates HTTPS and
# forwards to 127.0.0.1:8021. See README.md, "Without Docker".
[Unit]
Description=MyEditor membership sidecar
After=network-online.target
Wants=network-online.target

[Service]
User=myeditor-sidecar
Group=myeditor-sidecar
WorkingDirectory=/opt/myeditor
EnvironmentFile=/etc/myeditor-sidecar.env
ExecStart=/opt/myeditor/.venv-sidecar/bin/uvicorn sidecar.app:app --host 127.0.0.1 --port 8021 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
