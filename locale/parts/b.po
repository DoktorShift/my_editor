#: nostr/ui/account_windows.py:91
msgid "Your key couldn’t be saved on this computer. Make sure the disk has free space, then try again."
msgstr "Dein Schlüssel konnte nicht auf diesem Computer gespeichert werden. Sorge für freien Speicherplatz und versuche es dann erneut."

#: nostr/ui/account_windows.py:93
msgid "You can close this window. MyEditor keeps going in the background."
msgstr "Du kannst dieses Fenster schließen. MyEditor macht im Hintergrund weiter."

#: nostr/ui/account_windows.py:94
msgid "If you finish later, MyEditor tries again the next time you open it."
msgstr "Wenn du es später abschließt, versucht MyEditor es beim nächsten Start erneut."

#: nostr/ui/account_windows.py:167
msgid "Save Backup File"
msgstr "Sicherungsdatei speichern"

#: nostr/ui/account_windows.py:168
msgid "Text files (*.txt)"
msgstr "Textdateien (*.txt)"

#: nostr/ui/account_windows.py:226
#: nostr/ui/account_windows.py:912
msgid "Password:"
msgstr "Passwort:"

#: nostr/ui/account_windows.py:226
msgid "At least 8 characters"
msgstr "Mindestens 8 Zeichen"

#: nostr/ui/account_windows.py:227
msgid "Confirm:"
msgstr "Bestätigen:"

#: nostr/ui/account_windows.py:243
msgid "Save Backup File…"
msgstr "Sicherungsdatei speichern …"

#: nostr/ui/account_windows.py:251
#: nostr/ui/account_windows.py:611
msgid "Copy Private Key"
msgstr "Privaten Schlüssel kopieren"

#: nostr/ui/account_windows.py:254
msgid "Save Without a Password…"
msgstr "Ohne Passwort speichern …"

#: nostr/ui/account_windows.py:357
msgid "✓ Private key copied. Paste it somewhere only you can reach. MyEditor clears it from the clipboard in a minute."
msgstr "✓ Privater Schlüssel kopiert. Füge ihn dort ein, wo nur du hinkommst. MyEditor löscht ihn in einer Minute aus der Zwischenablage."

#: nostr/ui/account_windows.py:372
msgid "Back Up Account"
msgstr "Konto sichern"

#: nostr/ui/account_windows.py:409
msgid "Create Nostr Account"
msgstr "Nostr-Konto erstellen"

#: nostr/ui/account_windows.py:442
msgid "Your name"
msgstr "Dein Name"

#: nostr/ui/account_windows.py:444
msgid "Name:"
msgstr "Name:"

#: nostr/ui/account_windows.py:522
msgid "Keep the key on this computer"
msgstr "Schlüssel auf diesem Computer aufbewahren"

#: nostr/ui/account_windows.py:528
msgid "Use a signer app on your phone"
msgstr "Signer-App auf deinem Smartphone verwenden"

#: nostr/ui/account_windows.py:604
msgid "Private key code for Amber"
msgstr "Code mit deinem privaten Schlüssel für Amber"

#: nostr/ui/account_windows.py:608
#: nostr/ui/account_windows.py:623
#: nostr/ui/account_windows.py:632
msgid "Show Code for Amber"
msgstr "Code für Amber zeigen"

#: nostr/ui/account_windows.py:615
msgid "This code is your private key. Scan it only with your own Amber, on its Add account screen."
msgstr "Dieser Code ist dein privater Schlüssel. Scanne ihn nur mit deinem eigenen Amber, unter „Neues Konto hinzufügen“."

#: nostr/ui/account_windows.py:638
msgid "Hide Code"
msgstr "Code ausblenden"

#: nostr/ui/account_windows.py:642
msgid "Private key copied. Paste it in Amber’s Add account screen. MyEditor clears it from the clipboard in a minute."
msgstr "Privater Schlüssel kopiert. Füge ihn in Amber unter „Neues Konto hinzufügen“ ein. MyEditor löscht ihn in einer Minute aus der Zwischenablage."

#: nostr/ui/account_windows.py:739
msgid "Your account is saved, but it isn’t published yet."
msgstr "Dein Konto ist gespeichert, aber noch nicht veröffentlicht."

#: nostr/ui/account_windows.py:785
msgid "Restore Nostr Account"
msgstr "Nostr-Konto wiederherstellen"

#: nostr/ui/account_windows.py:811
msgid "Paste a Private Key Instead"
msgstr "Stattdessen privaten Schlüssel einfügen"

#: nostr/ui/account_windows.py:819
msgid "nsec1… or ncryptsec1…"
msgstr "nsec1… oder ncryptsec1…"

#: nostr/ui/account_windows.py:820
#: nostr/ui/account_windows.py:816
msgid "Private key"
msgstr "Privater Schlüssel"

#: nostr/ui/account_windows.py:855
msgid "Open Backup File"
msgstr "Sicherungsdatei öffnen"

#: nostr/ui/account_windows.py:856
msgid "Backup files (*.txt);;All files (*)"
msgstr "Sicherungsdateien (*.txt);;Alle Dateien (*)"

#: nostr/ui/account_windows.py:214
msgid "Your public key"
msgstr "Dein öffentlicher Schlüssel"

#: nostr/ui/account_windows.py:217
msgid "Copy"
msgstr "Kopieren"

#: nostr/ui/account_windows.py:220
msgid "Share it so people can find you."
msgstr "Teile ihn, damit andere dich finden."

#: nostr/ui/account_windows.py:223
msgid "Backup file"
msgstr "Sicherungsdatei"

#: nostr/ui/account_windows.py:233
msgid "The password protects the file. You need both to restore the account."
msgstr "Das Passwort schützt die Datei. Zum Wiederherstellen des Kontos brauchst du beides."

#: nostr/ui/account_windows.py:305
msgid "Save your private key without a password?"
msgstr "Privaten Schlüssel ohne Passwort speichern?"

#: nostr/ui/account_windows.py:306
msgid "Anyone who opens the file can use your account. A password-protected file is safer."
msgstr "Wer die Datei öffnet, kann dein Konto nutzen. Eine Datei mit Passwort ist sicherer."

#: nostr/ui/account_windows.py:319
msgid "Saving the backup…"
msgstr "Sicherung wird gespeichert …"

#: nostr/ui/account_windows.py:375
msgid "Back Up Your Account"
msgstr "Dein Konto sichern"

#: nostr/ui/account_windows.py:377
msgid "Nostr has no password reset. A backup lets you restore this account on another computer, or here if this one is reset."
msgstr "Bei Nostr lässt sich kein Passwort zurücksetzen. Mit einer Sicherung kannst du dieses Konto auf einem anderen Computer wiederherstellen, oder hier, falls dieser zurückgesetzt wird."

#: nostr/ui/account_windows.py:435
msgid "Create Your Nostr Account"
msgstr "Dein Nostr-Konto erstellen"

#: nostr/ui/account_windows.py:437
msgid "A Nostr account works in every Nostr app, and it belongs to you, not to MyEditor."
msgstr "Ein Nostr-Konto funktioniert in jeder Nostr-App, und es gehört dir, nicht MyEditor."

#: nostr/ui/account_windows.py:448
msgid "Optional. People see this name. You can change it later."
msgstr "Optional. Andere sehen diesen Namen. Du kannst ihn später ändern."

#: nostr/ui/account_windows.py:475
msgid "Save a Way Back In"
msgstr "Deinen Zugang sichern"

#: nostr/ui/account_windows.py:477
msgid "Nostr has no password reset. Your private key works like a password that can never be changed, and it is the only way back into this account. Save a backup now."
msgstr "Bei Nostr lässt sich kein Passwort zurücksetzen. Dein privater Schlüssel ist wie ein Passwort, das sich nie ändern lässt, und er ist der einzige Weg zurück in dieses Konto. Speichere jetzt eine Sicherung."

#: nostr/ui/account_windows.py:507
msgid "Continue without a backup?"
msgstr "Ohne Sicherung fortfahren?"

#: nostr/ui/account_windows.py:508
msgid "If this computer is lost or reset, nobody can get this account back for you."
msgstr "Geht dieser Computer verloren oder wird er zurückgesetzt, kann dir niemand dieses Konto zurückholen."

#: nostr/ui/account_windows.py:520
msgid "Choose How to Sign In"
msgstr "Art der Anmeldung wählen"

#: nostr/ui/account_windows.py:521
msgid "You can change this later."
msgstr "Du kannst das später ändern."

#: nostr/ui/account_windows.py:568
msgid "Your key is kept on this computer."
msgstr "Dein Schlüssel wird auf diesem Computer aufbewahrt."

#: nostr/ui/account_windows.py:574
msgid "Get Amber"
msgstr "Amber installieren"

#: nostr/ui/account_windows.py:576
msgid "Amber is a free signer app for Android. It keeps your private key on your phone and asks you before anything is signed."
msgstr "Amber ist eine kostenlose Signer-App für Android. Sie bewahrt deinen privaten Schlüssel auf deinem Smartphone auf und fragt dich, bevor etwas signiert wird."

#: nostr/ui/account_windows.py:578
msgid "Get Amber from Zapstore"
msgstr "Amber aus dem Zapstore laden"

#: nostr/ui/account_windows.py:583
msgid "Amber runs on Android only. On an iPhone, go back and keep the key on this computer for now."
msgstr "Amber gibt es nur für Android. Mit einem iPhone gehst du zurück und bewahrst den Schlüssel vorerst auf diesem Computer auf."

#: nostr/ui/account_windows.py:595
msgid "Add Your Key to Amber"
msgstr "Deinen Schlüssel zu Amber hinzufügen"

#: nostr/ui/account_windows.py:648
msgid "Connect Amber to MyEditor"
msgstr "Amber mit MyEditor verbinden"

#: nostr/ui/account_windows.py:654
msgid "MyEditor then checks that Amber signs as your new account."
msgstr "MyEditor prüft dann, ob Amber als dein neues Konto signiert."

#: nostr/ui/account_windows.py:678
msgid "Amber is signing as a different account. In Amber, select the account you just added, then try again."
msgstr "Amber signiert als ein anderes Konto. Wähle in Amber das Konto, das du gerade hinzugefügt hast, und versuche es dann erneut."

#: nostr/ui/account_windows.py:692
msgid "Amber holds your key."
msgstr "Amber bewahrt deinen Schlüssel auf."

#: nostr/ui/account_windows.py:698
msgid "Setting Up Your Account"
msgstr "Dein Konto wird eingerichtet"

#: nostr/ui/account_windows.py:719
msgid "Approve the requests in Amber when it asks."
msgstr "Bestätige die Anfragen, wenn Amber danach fragt."

#: nostr/ui/account_windows.py:720
msgid "MyEditor tells the Nostr network about your new account."
msgstr "MyEditor macht dein neues Konto im Nostr-Netzwerk bekannt."

#: nostr/ui/account_windows.py:741
msgid "Finish Later"
msgstr "Später abschließen"

#: nostr/ui/account_windows.py:756
msgid "You’re All Set"
msgstr "Alles bereit"

#: nostr/ui/account_windows.py:803
msgid "Restore Your Account"
msgstr "Dein Konto wiederherstellen"

#: nostr/ui/account_windows.py:805
msgid "Open the backup file you saved when you created the account."
msgstr "Öffne die Sicherungsdatei, die du beim Erstellen des Kontos gespeichert hast."

#: nostr/ui/account_windows.py:823
msgid "Only paste your private key into apps you trust. Anyone who has it can use your account."
msgstr "Füge deinen privaten Schlüssel nur in Apps ein, denen du vertraust. Wer ihn hat, kann dein Konto nutzen."

#: nostr/ui/account_windows.py:825
msgid "Use a Backup File Instead"
msgstr "Stattdessen Sicherungsdatei verwenden"

#: nostr/ui/account_windows.py:860
msgid "That file is too large to be a backup."
msgstr "Diese Datei ist zu groß für eine Sicherung."

#: nostr/ui/account_windows.py:906
msgid "Enter the Backup Password"
msgstr "Passwort der Sicherung eingeben"

#: nostr/ui/account_windows.py:908
msgid "The private key in this backup is protected with the password you chose when you saved it."
msgstr "Der private Schlüssel in dieser Sicherung ist mit dem Passwort geschützt, das du beim Speichern gewählt hast."

#: nostr/ui/account_windows.py:966
msgid "Restoring Your Account"
msgstr "Dein Konto wird wiederhergestellt"

#: nostr/ui/account_windows.py:344
msgid "The backup couldn’t be saved there. Choose another folder and try again."
msgstr "Die Sicherung konnte dort nicht gespeichert werden. Wähle einen anderen Ordner und versuche es erneut."

#: nostr/ui/account_windows.py:384
#: nostr/ui/account_windows.py:767
#: nostr/ui/account_windows.py:1016
#: nostr/ui/membership_window.py:971
msgid "Done"
msgstr "Fertig"

#: nostr/ui/account_windows.py:453
#: nostr/ui/account_windows.py:834
#: nostr/ui/account_windows.py:837
#: nostr/ui/account_windows.py:310
#: nostr/ui/membership_window.py:385
msgid "Cancel"
msgstr "Abbrechen"

#: nostr/ui/account_windows.py:454
#: nostr/ui/account_windows.py:492
#: nostr/ui/account_windows.py:550
#: nostr/ui/account_windows.py:590
#: nostr/ui/account_windows.py:835
#: nostr/ui/membership_window.py:297
msgid "Continue"
msgstr "Weiter"

#: nostr/ui/account_windows.py:490
#: nostr/ui/account_windows.py:549
#: nostr/ui/account_windows.py:589
#: nostr/ui/account_windows.py:624
#: nostr/ui/account_windows.py:665
#: nostr/ui/account_windows.py:926
#: nostr/ui/membership_window.py:532
msgid "Go Back"
msgstr "Zurück"

#: nostr/ui/account_windows.py:491
msgid "Skip for Now"
msgstr "Vorerst überspringen"

#: nostr/ui/account_windows.py:526
msgid "MyEditor keeps your private key in a file only your user account can read, and signs for you. The quickest way to start."
msgstr "MyEditor bewahrt deinen privaten Schlüssel in einer Datei auf, die nur dein Benutzerkonto lesen kann, und signiert für dich. Der schnellste Weg zum Start."

#: nostr/ui/account_windows.py:531
msgid "Your private key lives in Amber on your Android phone, and you approve what MyEditor signs there. Safer, and a few more steps."
msgstr "Dein privater Schlüssel liegt in Amber auf deinem Android-Smartphone, und dort bestätigst du, was MyEditor signiert. Sicherer, mit ein paar Schritten mehr."

#: nostr/ui/account_windows.py:625
msgid "I’ve Added It"
msgstr "Ist hinzugefügt"

#: nostr/ui/account_windows.py:666
msgid "Show Connection Code…"
msgstr "Verbindungscode zeigen …"

#: nostr/ui/account_windows.py:687
msgid "This account couldn’t be saved on this computer. Make sure the disk has free space, then try again."
msgstr "Dieses Konto konnte nicht auf diesem Computer gespeichert werden. Sorge für freien Speicherplatz und versuche es dann erneut."

#: nostr/ui/account_windows.py:702
msgid "Account saved"
msgstr "Konto gespeichert"

#: nostr/ui/account_windows.py:703
msgid "Publishing your relay list"
msgstr "Relay-Liste wird veröffentlicht"

#: nostr/ui/account_windows.py:704
msgid "Publishing your profile"
msgstr "Profil wird veröffentlicht"

#: nostr/ui/account_windows.py:733
#: nostr/ui/account_windows.py:1007
#: nostr/ui/membership_window.py:752
#: nostr/ui/membership_window.py:834
#: nostr/ui/connect_dialog.py:250
msgid "Close"
msgstr "Schließen"

#: nostr/ui/account_windows.py:743
#: nostr/ui/connect_dialog.py:358
msgid "Try Again"
msgstr "Erneut versuchen"

#: nostr/ui/account_windows.py:765
#, python-brace-format
msgid "{name} is ready. You can publish notes and articles, and keep private drafts that follow you to every device."
msgstr "{name} ist bereit. Du kannst Notizen und Artikel veröffentlichen und private Entwürfe anlegen, die dir auf jedes Gerät folgen."

#: nostr/ui/account_windows.py:838
msgid "Choose Backup File…"
msgstr "Sicherungsdatei wählen …"

#: nostr/ui/account_windows.py:871
msgid "That file couldn’t be opened. Choose the backup file again, or paste the key instead."
msgstr "Diese Datei konnte nicht geöffnet werden. Wähle die Sicherungsdatei erneut oder füge stattdessen den Schlüssel ein."

#: nostr/ui/account_windows.py:927
msgid "Restore"
msgstr "Wiederherstellen"

#: nostr/ui/account_windows.py:953
msgid "This backup couldn’t be opened."
msgstr "Diese Sicherung konnte nicht geöffnet werden."

#: nostr/ui/account_windows.py:970
msgid "Account saved on this computer"
msgstr "Konto auf diesem Computer gespeichert"

#: nostr/ui/account_windows.py:971
msgid "Finding your relay list"
msgstr "Relay-Liste wird gesucht"

#: nostr/ui/account_windows.py:972
msgid "Finding your profile"
msgstr "Profil wird gesucht"

#: nostr/ui/account_windows.py:309
msgid "Save Without Password"
msgstr "Ohne Passwort speichern"

#: nostr/ui/account_windows.py:348
#, python-brace-format
msgid "✓ Backup saved to {path}"
msgstr "✓ Sicherung gespeichert unter {path}"

#: nostr/ui/account_windows.py:511
msgid "Continue Without Backup"
msgstr "Ohne Sicherung fortfahren"

#: nostr/ui/account_windows.py:512
msgid "Save a Backup"
msgstr "Sicherung speichern"

#: nostr/ui/account_windows.py:597
msgid "In Amber, choose Add account. Not Connect app."
msgstr "Wähle in Amber „Neues Konto hinzufügen“, nicht „App verbinden“."

#: nostr/ui/account_windows.py:598
msgid "Choose to use a private key, then scan the code below or paste the key you copy here."
msgstr "Wähle die Anmeldung mit privatem Schlüssel. Scanne dann den Code unten oder füge den Schlüssel ein, den du hier kopierst."

#: nostr/ui/account_windows.py:650
msgid "In Amber, open Connect app (the scan icon)."
msgstr "Öffne in Amber „App verbinden“ (das Scan-Symbol)."

#: nostr/ui/account_windows.py:651
msgid "Scan the code MyEditor shows, and approve the request."
msgstr "Scanne den Code, den MyEditor zeigt, und bestätige die Anfrage."

#: nostr/ui/account_windows.py:950
msgid "The password is wrong. Try again."
msgstr "Das Passwort ist falsch. Versuche es erneut."

#: nostr/account_controller.py:314
msgid "Publish a relay list for this account?"
msgstr "Relay-Liste für dieses Konto veröffentlichen?"

#: nostr/account_controller.py:357
msgid "Delete the private key kept on this computer?"
msgstr "Privaten Schlüssel auf diesem Computer löschen?"

#: nostr/account_controller.py:383
#, python-brace-format
msgid "Sign out of {name}?"
msgstr "{name} abmelden?"

#: nostr/account_controller.py:328
msgid "Your relay list is published."
msgstr "Deine Relay-Liste ist veröffentlicht."

#: nostr/account_controller.py:388
msgid "MyEditor deletes the private key it keeps for this account. Without a backup, nobody can get this account back."
msgstr "MyEditor löscht den privaten Schlüssel, den es für dieses Konto aufbewahrt. Ohne Sicherung kann niemand dieses Konto zurückholen."

#: nostr/account_controller.py:390
#: nostr/account_controller.py:396
msgid "Sign Out and Delete Key"
msgstr "Abmelden und Schlüssel löschen"

#: nostr/account_controller.py:145
msgid "This account’s key isn’t on this computer"
msgstr "Der Schlüssel dieses Kontos ist nicht auf diesem Computer"

#: nostr/account_controller.py:146
msgid "MyEditor can’t find the private key it kept for this account. If you saved a backup, restore the account from it."
msgstr "MyEditor findet den privaten Schlüssel nicht, den es für dieses Konto aufbewahrt hat. Wenn du eine Sicherung gespeichert hast, stelle das Konto daraus wieder her."

#: nostr/account_controller.py:151
msgid "This account’s key is in your signer app"
msgstr "Der Schlüssel dieses Kontos liegt in deiner Signer-App"

#: nostr/account_controller.py:152
msgid "Back it up there."
msgstr "Sichere ihn dort."

#: nostr/account_controller.py:220
msgid "Your new account is set up on the Nostr network."
msgstr "Dein neues Konto ist im Nostr-Netzwerk eingerichtet."

#: nostr/account_controller.py:271
msgid "This account has no relay list yet."
msgstr "Dieses Konto hat noch keine Relay-Liste."

#: nostr/account_controller.py:273
#: nostr/account_controller.py:289
msgid "Couldn’t check right now."
msgstr "Konnte gerade nicht geprüft werden."

#: nostr/account_controller.py:291
msgid "No public profile found."
msgstr "Kein öffentliches Profil gefunden."

#: nostr/account_controller.py:315
#, python-brace-format
msgid "Other Nostr apps use a relay list to find your notes and articles, and this account doesn’t have one yet. MyEditor can publish its recommended relays: {hosts}."
msgstr "Andere Nostr-Apps finden deine Notizen und Artikel über eine Relay-Liste, und dieses Konto hat noch keine. MyEditor kann seine empfohlenen Relays veröffentlichen: {hosts}."

#: nostr/account_controller.py:318
#: nostr/ui/membership_window.py:290
#: nostr/ui/membership_window.py:293
#: nostr/ui/membership_window.py:296
#: nostr/ui/membership_window.py:1007
msgid "Not Now"
msgstr "Nicht jetzt"

#: nostr/account_controller.py:319
msgid "Publish Relay List"
msgstr "Relay-Liste veröffentlichen"

#: nostr/account_controller.py:330
msgid "This account already has a relay list."
msgstr "Dieses Konto hat bereits eine Relay-Liste."

#: nostr/account_controller.py:332
msgid "The relay list wasn’t published. Try again later."
msgstr "Die Relay-Liste wurde nicht veröffentlicht. Versuche es später erneut."

#: nostr/account_controller.py:358
#, python-brace-format
msgid "{name} now signs with your signer app, which holds the same key. MyEditor still keeps a copy of it on this computer. Deleting it leaves the key only where you approve what is signed."
msgstr "{name} signiert jetzt mit deiner Signer-App, die denselben Schlüssel hat. MyEditor bewahrt noch eine Kopie davon auf diesem Computer auf. Löschst du sie, liegt der Schlüssel nur noch dort, wo du bestätigst, was signiert wird."

#: nostr/account_controller.py:362
msgid "Keep Key"
msgstr "Schlüssel behalten"

#: nostr/account_controller.py:363
msgid "Delete Key"
msgstr "Schlüssel löschen"

#: nostr/account_controller.py:372
msgid "The private key couldn’t be deleted"
msgstr "Der private Schlüssel konnte nicht gelöscht werden"

#: nostr/account_controller.py:373
msgid "MyEditor couldn’t change the file it keeps keys in. Make sure the disk isn’t full or read-only, then try again."
msgstr "MyEditor konnte die Datei mit den Schlüsseln nicht ändern. Stelle sicher, dass das Laufwerk nicht voll oder schreibgeschützt ist, und versuche es dann erneut."

#: nostr/account_controller.py:394
msgid "Your key stays in your signer. MyEditor forgets this connection and deletes the copy of the key it keeps on this computer."
msgstr "Dein Schlüssel bleibt in deinem Signer. MyEditor vergisst diese Verbindung und löscht die Kopie des Schlüssels auf diesem Computer."

#: nostr/account_controller.py:267
#, python-brace-format
msgid "Found, with {count} relay to write to."
msgid_plural "Found, with {count} relays to write to."
msgstr[0] "Gefunden: {count} Relay zum Veröffentlichen."
msgstr[1] "Gefunden: {count} Relays zum Veröffentlichen."

#: nostr/account_controller.py:287
#, python-brace-format
msgid "Welcome back, {name}."
msgstr "Willkommen zurück, {name}."

#: nostr/account_controller.py:400
msgid "This account’s private key isn’t on this computer. MyEditor forgets the account."
msgstr "Der private Schlüssel dieses Kontos ist nicht auf diesem Computer. MyEditor vergisst das Konto."

#: nostr/account_controller.py:402
#: nostr/account_controller.py:408
msgid "Sign Out"
msgstr "Abmelden"

#: nostr/account_controller.py:406
msgid "Your key stays in your signer. MyEditor only forgets this connection."
msgstr "Dein Schlüssel bleibt in deinem Signer. MyEditor vergisst nur diese Verbindung."

#: nostr/ui/membership_window.py:78
msgid "Approve the request in your signer app."
msgstr "Bestätige die Anfrage in deiner Signer-App."

#: nostr/ui/membership_window.py:79
msgid "One moment."
msgstr "Einen Moment."

#: nostr/ui/membership_window.py:80
msgid "Your signer app may ask you to approve."
msgstr "Deine Signer-App fragt dich eventuell nach einer Bestätigung."

#: nostr/ui/membership_window.py:81
msgid "Membership belongs to your Nostr identity and runs for a calendar year. You renew it yourself; nothing is charged automatically."
msgstr "Die Mitgliedschaft gehört zu deiner Nostr-Identität und gilt für ein Kalenderjahr. Du verlängerst sie selbst; nichts wird automatisch abgebucht."

#: nostr/ui/membership_window.py:93
#, python-brace-format
msgid "{day} {month} {year}"
msgstr "{day}. {month} {year}"

#: nostr/ui/membership_window.py:145
msgid "EINUNDZWANZIG Membership"
msgstr "EINUNDZWANZIG-Mitgliedschaft"

#: nostr/ui/membership_window.py:205
#: nostr/ui/membership_window.py:871
#: nostr/ui/membership_window.py:1051
msgid "Add to My Relay List"
msgstr "Zu meiner Relay-Liste hinzufügen"

#: nostr/ui/membership_window.py:273
msgid "Included"
msgstr "Enthalten"

#: nostr/ui/membership_window.py:400
msgid "MyEditor is asking EINUNDZWANZIG where your membership stands."
msgstr "MyEditor fragt bei EINUNDZWANZIG nach dem Stand deiner Mitgliedschaft."

#: nostr/ui/membership_window.py:421
#: nostr/ui/membership_window.py:513
msgid "Your Application"
msgstr "Dein Antrag"

