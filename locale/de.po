msgstr[1] "Die Anfrage, „{title}“ zu löschen, wurde von {accepted} von {total} Relays angenommen."

#: nostr/ui/published_view.py:552
msgid "Couldn’t load what you published"
msgstr "Deine Veröffentlichungen konnten nicht geladen werden"

#: nostr/ui/published_view.py:553
msgid "Check your internet connection, then try again."
msgstr "Prüfe deine Internetverbindung und versuche es dann erneut."

#: nostr/ui/published_view.py:638
#, python-brace-format
msgid "Delete “{title}” from Nostr?"
msgstr "„{title}“ aus Nostr löschen?"

